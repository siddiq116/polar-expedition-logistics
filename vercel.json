{
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "backend/server.js",
      "installCommand": "npm install --prefix backend && npm install --prefix frontend",
      "buildCommand": "npm run build --prefix frontend",
      "functions": {
        "backend/server.js": {
          "includeFiles": "frontend/dist/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
