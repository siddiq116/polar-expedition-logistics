{
  "services": {
    "app": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm install && npm install --prefix ../frontend",
      "buildCommand": "npm run build --prefix ../frontend",
      "functions": {
        "server.js": {
          "includeFiles": "../frontend/dist/**/*"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
